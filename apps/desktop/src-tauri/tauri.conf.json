{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "msword-use",
  "version": "0.1.0",
  "identifier": "com.mswordUse.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "msword-use",
        "width": 1100,
        "height": 760,
        "visible": true,
        "skipTaskbar": false
      },
      {
        "label": "spotlight",
        "title": "msword-use spotlight",
        "url": "spotlight.html",
        "width": 720,
        "height": 92,
        "minWidth": 720,
        "minHeight": 92,
        "maxWidth": 720,
        "maxHeight": 320,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
