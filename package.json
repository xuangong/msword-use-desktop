{
  "name": "msword-use-desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Drive Microsoft Word from a desktop UI via natural language",
  "workspaces": [
    "apps/desktop",
    "apps/agent"
  ],
  "scripts": {
    "driver:build": "cd drivers/WordDriver && dotnet build -c Debug",
    "driver:build:release": "cd drivers/WordDriver && dotnet build -c Release",
    "driver:test": "bun run scripts/test-driver.ts",
    "dev": "cd apps/desktop && bun run tauri dev",
    "package:prepare": "bun run scripts/prepare-windows-package.ts",
    "package:windows": "bun run package:prepare && cd apps/desktop && bun run tauri build",
    "package:windows:dist": "bun run package:windows && bun run scripts/make-windows-dist.ts",
    "install:windows": "powershell -ExecutionPolicy Bypass -File scripts/install-windows.ps1",
    "build": "bun run package:windows",
    "spike": "drivers/WordDriver/bin/Debug/net48/WordDriver.exe"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.78.1",
    "@earendil-works/pi-ai": "0.78.1",
    "@types/bun": "latest",
    "typebox": "1.1.38",
    "typescript": "^5.6.0"
  }
}
